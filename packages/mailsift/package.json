{
  "name": "mailsift",
  "version": "0.1.0",
  "description": "A read-only mail reader for Node: connect, search and fetch messages as plain text.",
  "keywords": [
    "imap",
    "email",
    "mail",
    "gmail",
    "yahoo",
    "read-only",
    "search",
    "mailbox"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jishnupramod/mailsift.git",
    "directory": "packages/mailsift"
  },
  "homepage": "https://github.com/jishnupramod/mailsift#readme",
  "bugs": {
    "url": "https://github.com/jishnupramod/mailsift/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:live": "pnpm build && node scripts/live.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "imapflow": "2.12.2",
    "mailparser": "3.15.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
